{
  "name": "genie-magnet-agency-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w @gm/shared && npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "build:services": "npm run generate -w @gm/db && tsc -b tsconfig.services.json",
    "dev:api": "npm run build:services && npm run dev -w api",
    "dev:worker": "npm run build:services && node --env-file-if-exists=.env apps/worker/dist/main.js",
    "dev:local": "npm run build:services && node scripts/dev-local.mjs",
    "typecheck": "npm run build:services && tsc --noEmit -p apps/web",
    "test": "npm run build:services && npm test -w @gm/shared -w @gm/db -w api -w worker",
    "format": "prettier --write \"apps/api/**/*.ts\" \"apps/worker/**/*.ts\" \"packages/**/*.{ts,json}\" \"docs/**/*.md\" \"*.{json,md}\"",
    "format:check": "prettier --check \"apps/api/**/*.ts\" \"apps/worker/**/*.ts\" \"packages/**/*.{ts,json}\"",
    "db:generate": "npm run generate -w @gm/db",
    "db:migrate": "npm run migrate:dev -w @gm/db",
    "db:diff": "npm run migrate:diff -w @gm/db",
    "db:seed": "npm run build:services && npm run seed -w @gm/db",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20.9 <23"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
