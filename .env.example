# Copy to .env for local development (infra/docker-compose.yml). Never commit real secrets.

# Runtime connection — the API and worker use the genie_app role, so row-level security always applies.
DATABASE_URL="postgresql://genie_app:genie_app_dev@localhost:5432/genie"
# Migrations only — the schema owner.
DATABASE_OWNER_URL="postgresql://genie_owner:genie_owner_dev@localhost:5432/genie"
# Sign-in only (Better Auth) — genie_auth reaches the sign-in tables and nothing else.
AUTH_DATABASE_URL="postgresql://genie_auth:genie_auth_dev@localhost:5432/genie"

REDIS_URL="redis://localhost:6379"

S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="genie-files"
S3_ACCESS_KEY="genie"
S3_SECRET_KEY="genie-secret-dev"

SMTP_URL="smtp://localhost:1025"

API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-32-random-bytes"
BETTER_AUTH_URL="http://localhost:4000"
# better-auth (real sign-in) or dev-header (x-agency-id header, local only)
AUTH_MODE="better-auth"
# Sign in as any person without a password (testing only; refused in production, never with real data)
TEST_SIGN_IN="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Phase 4 — Genie Assistant
ANTHROPIC_API_KEY=""

# Hosted demo only (apps/web)
DEMO_PASSCODE=""
FEEDBACK_DIR=""
