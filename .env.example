# Copy to .env for local development (infra/docker-compose.yml). Never commit real secrets.

# Runtime connection — the API and the background worker use the genie_app role, so row-level security always applies.
DATABASE_URL="postgresql://genie_app:genie_app_dev@localhost:5432/genie"
# Migrations only — the schema owner.
DATABASE_OWNER_URL="postgresql://genie_owner:genie_owner_dev@localhost:5432/genie"
# Servers only (npm run db:setup, see docs/STAGING.md): the passwords db:setup gives the genie_app and genie_auth roles,
# and whether it loads the sample agencies (staging only; refused with APP_ENV="production").
APP_DB_PASSWORD=""
AUTH_DB_PASSWORD=""
SEED_SAMPLE_DATA="false"
# "staging" on a shared test server with sample data (test sign-in may stay on); "production" with real data.
APP_ENV=""
# Sign-in only (Better Auth) — genie_auth reaches the sign-in tables and nothing else.
AUTH_DATABASE_URL="postgresql://genie_auth:genie_auth_dev@localhost:5432/genie"

S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="genie-files"
S3_ACCESS_KEY="genie"
S3_SECRET_KEY="genie-secret-dev"

SMTP_URL="smtp://localhost:1025"

API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-32-random-bytes"
BETTER_AUTH_URL="http://localhost:4000"
# better-auth (real sign-in) or dev-header (x-agency-id header, local only)
AUTH_MODE="better-auth"
# Sign in as any person without a password (testing only; refused in production, never with real data)
TEST_SIGN_IN="true"
# Confirm email addresses (sign-up link; required to accept invitations). Off while testing; must be "true" in production.
REQUIRE_EMAIL_VERIFICATION="false"
# Requests per minute per person on each API route; proxies in front of the API (1 on Railway)
RATE_LIMIT_PER_MINUTE=300
TRUST_PROXY=0
# The API's own public address (uploads go straight to it), where files are kept (a mounted volume on a server),
# the largest upload in MB, and the key that signs file links (falls back to BETTER_AUTH_SECRET)
PUBLIC_API_URL="http://localhost:4000"
FILES_DIR=".files"
FILE_MAX_MB=1024
FILES_SECRET=""
# Encrypts secrets kept in the database (agencies' WhatsApp tokens, payment keys); falls back to BETTER_AUTH_SECRET.
SECRETS_KEY=""
# WhatsApp: "outbox" keeps messages in the app (nothing is sent); "cloud" sends through each agency's own number.
WHATSAPP_PROVIDER="outbox"
# Payment links: "outbox" makes pretend links in the app (no money moves); "razorpay" uses each agency's own account.
PAYMENTS_PROVIDER="outbox"
# Background jobs (ADR 0010): run them in the API process (one server), or keep this off and run `npm run dev:worker`.
# Daily jobs run at JOBS_DAILY_AT in UTC (02:30 UTC is 08:00 in India).
RUN_JOBS="true"
JOBS_DAILY_AT="02:30"
JOBS_POLL_SECONDS=10
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Clients' social accounts: "outbox" pretends (nothing is posted); "live" uses our own apps. A platform whose keys are
# empty is posted by hand.
SOCIAL_PROVIDER="outbox"
META_APP_ID=""
META_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Phase 4 — Genie Assistant
ANTHROPIC_API_KEY=""

# Hosted demo only (apps/web)
DEMO_PASSCODE=""
FEEDBACK_DIR=""
