  rows       Json
  challenges Json     @default("[]")
  notes      String   @default("")
  createdBy  String?  @map("created_by")
  takenAt    DateTime @default(now()) @map("taken_at")

  @@index([agencyId, takenAt])
  @@map("diagnostic_snapshots")
}

/// An item on the Strategic Road Map (P5-18).
model RoadMapItem {
