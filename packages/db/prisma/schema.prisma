  inputs    Json
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("scenarios")
}

// ───────────────────────────── Financial planner ─────────────────────────────

/// A person's own financial planner (P5-19): setup, daily spending log, money behaviour answers. Theirs alone.
model PersonalPlanner {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  userId    String   @map("user_id")
  data      Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, userId])
  @@map("personal_planners")
}

// ───────────────────────────── Equipment and assets (P5-20) ─────────────────────────────

/// An item the agency owns: its cost and useful life for straight-line depreciation, and its condition.
model Asset {
  id              String    @id @default(uuid(7)) @db.Uuid
  agencyId        String    @map("agency_id") @db.Uuid
  tag             String
  name            String
  category        String
  serialNo        String    @default("") @map("serial_no")
  purchaseDate    DateTime  @map("purchase_date") @db.Date
  purchaseValue   Int       @map("purchase_value")
  residualValue   Int       @default(0) @map("residual_value")
  usefulLifeYears Int       @map("useful_life_years")
  /// Productive hours a year, for its cost per hour; null when its use is not costed by the hour.
  hoursPerYear    Int?      @map("hours_per_year")
  /// Excellent · Good · Fair · Needs repair
  condition       String    @default("Good")
  location        String    @default("")
  notes           String    @default("")
  retiredAt       DateTime? @map("retired_at")
  retiredNote     String    @default("") @map("retired_note")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  custody      AssetCustody[]
  reservations AssetReservation[]
  maintenance  AssetMaintenance[]

  @@unique([agencyId, tag])
  @@map("assets")
}

/// Who has it: checked out for a while (a shoot, a trip) or assigned for good, and when it came back.
model AssetCustody {
  id              String    @id @default(uuid(7)) @db.Uuid
  agencyId        String    @map("agency_id") @db.Uuid
  assetId         String    @map("asset_id") @db.Uuid
  /// out · assigned
  kind            String    @default("out")
  userId          String    @map("user_id")
  shootId         String?   @map("shoot_id") @db.Uuid
  purpose         String    @default("")
  dueOn           DateTime? @map("due_on") @db.Date
  note            String    @default("")
  outAt           DateTime  @default(now()) @map("out_at")
  outBy           String?   @map("out_by")
  returnedAt      DateTime? @map("returned_at")
  returnedTo      String?   @map("returned_to")
  returnCondition String?   @map("return_condition")
  /// Minutes of use, recorded on its return.
  minutes         Int?
  returnNote      String    @default("") @map("return_note")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([agencyId, assetId])
  @@index([agencyId, shootId])
  @@index([agencyId, userId])
  @@map("asset_custody")
}

/// An item booked for a day, for a person and a shoot or purpose.
model AssetReservation {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  date      DateTime @db.Date
  userId    String   @map("user_id")
  shootId   String?  @map("shoot_id") @db.Uuid
  purpose   String   @default("")
  location  String   @default("")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([agencyId, assetId, date])
  @@index([agencyId, date])
  @@map("asset_reservations")
}

/// A service or repair; one that takes the item out of service stays open until it is back.
model AssetMaintenance {
  id             String    @id @default(uuid(7)) @db.Uuid
  agencyId       String    @map("agency_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  date           DateTime  @db.Date
  title          String
  by             String    @default("")
  cost           Int       @default(0)
  note           String    @default("")
  outOfService   Boolean   @default(false) @map("out_of_service")
  closedAt       DateTime? @map("closed_at")
  closedBy       String?   @map("closed_by")
  closeCondition String?   @map("close_condition")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([agencyId, assetId])
  @@map("asset_maintenance")
}

// ───────────────────────────── Projects and tasks (P5-21) ─────────────────────────────

/// Work that is not a video: a website, an event, a new person's joining.
model Project {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  name        String
  clientId    String?   @map("client_id") @db.Uuid
  ownerId     String    @map("owner_id")
  /// The person a joining project is about.
  joinerId    String?   @map("joiner_id")
  description String    @default("")
  startOn     DateTime? @map("start_on") @db.Date
  dueOn       DateTime? @map("due_on") @db.Date
  /// active · on_hold · done · cancelled
  status      String    @default("active")
  /// The task list it was started from.
  templateKey String?   @map("template_key")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks  Task[]

  @@index([agencyId, status])
  @@map("projects")
}

/// A piece of work with one person accountable: in a project, or on its own (a commitment carried forward).
model Task {
  id           String    @id @default(uuid(7)) @db.Uuid
  agencyId     String    @map("agency_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  title        String
  notes        String    @default("")
  ownerId      String    @map("owner_id")
  dueOn        DateTime? @map("due_on") @db.Date
  /// high · medium · low
  priority     String    @default("medium")
  /// todo · in_progress · done
  status       String    @default("todo")
  /// A task of the same project that has to be done first.
  dependsOnId  String?   @map("depends_on_id") @db.Uuid
  /// manual · template · joining · commitment
  source       String    @default("manual")
  commitmentId String?   @map("commitment_id") @db.Uuid
  position     Int       @default(0)
  completedAt  DateTime? @map("completed_at")
  completedBy  String?   @map("completed_by")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependsOn  Task?       @relation("TaskDependency", fields: [dependsOnId], references: [id], onDelete: SetNull)
  waitedOnBy Task[]      @relation("TaskDependency")
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  @@index([agencyId, ownerId, status])
  @@index([agencyId, projectId])
  @@index([agencyId, commitmentId])
  @@map("tasks")
}

/// The agency's task lists to start projects from, the joining list among them.
model ProjectSettings {
  agencyId  String   @id @map("agency_id") @db.Uuid
  templates Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("project_settings")
}

// ───────────────────────────── Plans and the platform (P6-01 to P6-03, ADR 0011) ─────────────────────────────

/// The platform's own settings: brand, trial, grace period, plans and our invoice details. One row.
model PlatformSettings {
  id        Int      @id @default(1)
  data      Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// An agency's plan and where it stands with paying. No row: every suite and no limits.
model Subscription {
  agencyId         String    @id @map("agency_id") @db.Uuid
  planKey          String    @map("plan_key")
  /// trialing · active · past_due · expired · cancelled
  status           String    @default("trialing")
  trialEndsAt      DateTime? @map("trial_ends_at")
  currentPeriodEnd DateTime? @map("current_period_end")
  graceUntil       DateTime? @map("grace_until")
  /// outbox · razorpay · stripe
  provider         String    @default("outbox")
  providerRef      String?   @map("provider_ref")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("subscriptions")
}

/// Our invoice to an agency for its plan (P6-04): issued when a payment comes in, numbered across the platform.
model PlatformInvoice {
  id          String   @id @default(uuid(7)) @db.Uuid
  agencyId    String   @map("agency_id") @db.Uuid
  number      String   @unique
  issuedOn    DateTime @map("issued_on") @db.Date
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  planKey     String   @map("plan_key")
  planName    String   @map("plan_name")
  /// INR · USD
  currency    String   @default("INR")
  /// Before tax, in whole rupees or dollars.
  amount      Int
  cgst        Int      @default(0)
  sgst        Int      @default(0)
  igst        Int      @default(0)
  total       Int
  gstRate     Float    @default(0) @map("gst_rate")
  /// Our details and the agency's, as they were when it was issued.
  seller      Json
  buyer       Json
  sac         String   @default("")
  /// outbox · razorpay · stripe
  provider    String
  paymentRef  String   @map("payment_ref")
  paidAt      DateTime @default(now()) @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, paymentRef])
  @@index([agencyId, issuedOn])
  @@map("platform_invoices")
}

/// The agency's consent for the platform's support team to come in (P6-08): for some hours, seeing only or also
/// fixing, for a reason; revocable, and every visit is in the agency's audit log.
model SupportGrant {
  id         String    @id @default(uuid(7)) @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  /// view · edit
  level      String    @default("view")
  reason     String
  expiresAt  DateTime  @map("expires_at")
  grantedBy  String    @map("granted_by")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([agencyId, expiresAt])
  @@map("support_grants")
}

/// A full export of the agency's data (P6-10): a ZIP with CSV per table and a JSON archive, for the owner.
model DataExport {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  /// queued · ready · failed
  status      String    @default("queued")
  requestedBy String    @map("requested_by")
  storageKey  String?   @map("storage_key")
  size        BigInt?
  tables      Int?
  rows        Int?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  readyAt     DateTime? @map("ready_at")

  @@index([agencyId, createdAt])
  @@map("data_exports")
}

/// The owner asked for the workspace to be deleted (P6-10): it is, after the grace period, unless stopped.
model WorkspaceDeletion {
  agencyId    String    @id @map("agency_id") @db.Uuid
  requestedBy String    @map("requested_by")
  requestedAt DateTime  @default(now()) @map("requested_at")
  deleteAfter DateTime  @map("delete_after")
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by")

  @@map("workspace_deletions")
}

/// Sample data an agency added to try things with (P6-06): the records made, so they can all be removed in one go.
model SampleData {
  agencyId  String    @id @map("agency_id") @db.Uuid
  clientIds String[]  @map("client_ids")
  leadIds   String[]  @map("lead_ids")
  videoIds  String[]  @map("video_ids")
  addedBy   String?   @map("added_by")
  addedAt   DateTime  @default(now()) @map("added_at")
  removedAt DateTime? @map("removed_at")
  removedBy String?   @map("removed_by")

  @@map("sample_data")
}
