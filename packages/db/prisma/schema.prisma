// Genie Magnet OS — database design v0 (Phase 0 draft for team review).
//
// Rules for every model:
//   • Every tenant table has agency_id and a row-level security policy (see migrations/*_rls).
//   • The API and worker connect as genie_app, which cannot bypass RLS; queries run through
//     forAgency()/withAgency() in src/tenancy.ts, which set app.agency_id for the transaction.
//   • Money is whole rupees (Int). Dates without a time use @db.Date.
//   • Sign-in tables (users, sessions, accounts, verifications) belong to Better Auth, which connects
//     as genie_auth: it can reach only sign-in tables, agencies, memberships and invitations.
//   • HR, payroll and finance tables arrive in Phase 5 (see docs/adr and the development plan).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Tenancy & people ─────────────────────────────

enum Plan {
  starter
  growth
  pro
  internal
}

model Agency {
  id                String         @id @default(uuid(7)) @db.Uuid
  name              String
  slug              String         @unique
  /// Small image as a data URL (resized in the browser) until file storage arrives.
  logo              String?
  /// Better Auth organization metadata (JSON string).
  metadata          String?
  plan              Plan           @default(starter)
  /// Brand colour (#rrggbb) for the client portal and documents.
  brandColor        String?        @map("brand_color")
  /// The agency's own Growth OS stage.
  businessStage     BusinessStage? @map("business_stage")
  phone             String?
  email             String?
  website           String?
  city              String?
  /// Days to complete the deeper onboarding sections (Growth OS default 7).
  windowDays        Int            @default(7) @map("window_days")
  /// Days after sending a questionnaire when reminders go out (Growth OS default day 2 and day 5).
  reminderDays      Int[]          @default([2, 5]) @map("reminder_days")
  /// Languages used with clients (ISO codes), e.g. en, ta.
  languages         String[]       @default(["en"])
  /// Largest discount (%) a proposal can carry without approval (Growth OS sales authority, default 10).
  discountLimit     Int            @default(10) @map("discount_limit")
  /// Days before an agreement ends that it shows as due for renewal (P1-19).
  renewalNoticeDays Int            @default(45) @map("renewal_notice_days")
  /// The owner hid the set-up guide on Home (P1-32).
  setupHiddenAt     DateTime?      @map("setup_hidden_at")
  /// The brand colour across the team's own app too, not only for clients (P6-07).
  appBranding       Boolean        @default(false) @map("app_branding")
  /// The agency's own address for its client links, e.g. portal.youragency.com (P6-07), the token of the DNS record
  /// proving it controls it, and when that record was seen.
  portalDomain           String?   @unique @map("portal_domain")
  portalDomainToken      String?   @map("portal_domain_token")
  portalDomainVerifiedAt DateTime? @map("portal_domain_verified_at")
  /// How client onboarding is filled in by default: "link" (the client answers by private link) or "assisted"
  /// (the account manager fills it in with the client on a call). Both are always available (P1-22).
  onboardingMode    String         @default("link") @map("onboarding_mode")
  createdAt         DateTime       @default(now()) @map("created_at")

  memberships Membership[]
  invitations Invitation[]
  roles       Role[]
  stages      PipelineStage[]
  clients     Client[]
  packages    Package[]

  @@map("agencies")
}

/// Global identity (Better Auth). A user can belong to several agencies in the SaaS.
model User {
  id            String   @id
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

model Session {
  id                   String   @id
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  /// The agency every request in this session works in (Better Auth's active organization).
  activeOrganizationId String?  @map("active_agency_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Sign-in methods per user (password hash, Google). Never readable by genie_app.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  userId    String   @map("user_id")
  /// Role key defined by the agency (defaults: owner, manager, …) — permissions live in the agency's matrix.
  role      String
  title     String?
  createdAt DateTime @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId])
  @@map("memberships")
}

/// The agency's roles and its permission matrix (P1-11). Memberships and invitations refer to a role by `key`.
/// Every agency starts with the default roles from @gm/shared and edits its own copy. The "owner" role
/// always has full access, whatever is stored here.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  agencyId    String   @map("agency_id") @db.Uuid
  /// Stable key stored on memberships and invitations: the name can change, the key never does.
  key         String
  name        String
  description String?
  /// { area: { level, scope? } }, validated by permissionMatrix in @gm/shared. A missing area means no access.
  permissions Json     @default("{}")
  /// Client people (approvers, viewers) only ever use the client portal.
  isClient    Boolean  @default(false) @map("is_client")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, key])
  @@map("roles")
}

model Invitation {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  email     String
  role      String
  status    String   @default("pending")
  expiresAt DateTime @map("expires_at")
  inviterId String   @map("inviter_id")
  createdAt DateTime @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, email])
  @@map("invitations")
}

/// Append-only: genie_app may insert and read, never update or delete.
model AuditLog {
  id       String   @id @default(uuid(7)) @db.Uuid
  agencyId String   @map("agency_id") @db.Uuid
  actorId  String?  @map("actor_id")
  action   String
  entity   String
  entityId String?  @map("entity_id")
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([agencyId, entity, entityId])
  @@index([agencyId, at])
  @@map("audit_logs")
}

/// A spreadsheet import (P1-31): what it created, so it can be shown in history and undone within 24 hours.
/// The file itself is read in the browser and never stored.
model Import {
  id         String    @id @default(uuid(7)) @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  /// clients · team · leads · videos · agreements
  kind       String
  fileName   String    @map("file_name")
  rowCount   Int       @map("row_count")
  /// Ids of the records it created (clients, invitations, leads, videos or agreements).
  createdIds String[]  @map("created_ids")
  /// The check report (P3-12): totals to compare with the sheet, rows left out and why, things worth a look.
  report     Json?
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  undoneAt   DateTime? @map("undone_at")
  undoneBy   String?   @map("undone_by")

  @@index([agencyId, createdAt])
  @@map("imports")
}

/// An uploaded file (P1-05), kept under the agency's own folder in file storage and linked to the record it belongs to.
/// Pending until the upload finishes; uploads and downloads go through short-lived signed links.
model FileObject {
  id         String    @id @default(uuid(7)) @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  storageKey String    @map("storage_key")
  name       String
  mime       String
  /// Bytes (the size declared when the upload starts; checked as it arrives).
  size       BigInt
  /// What it belongs to: client · onboarding · video · script… and that record's id.
  entity     String?
  entityId   String?   @map("entity_id")
  /// pending · ready
  status     String    @default("pending")
  uploadedBy String?   @map("uploaded_by")
  uploadedAt DateTime? @map("uploaded_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([agencyId, storageKey])
  @@index([agencyId, entity, entityId])
  @@map("files")
}

/// A notification in the app (P1-04), for one person in one agency.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  userId    String    @map("user_id")
  /// One of NOTIFICATION_KINDS in @gm/shared.
  kind      String
  title     String
  body      String?
  /// Where it leads in the app.
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([agencyId, userId, readAt])
  @@index([agencyId, userId, createdAt])
  @@map("notifications")
}

/// What each person wants to be told about, per agency.
model NotificationPreference {
  agencyId  String   @map("agency_id") @db.Uuid
  userId    String   @map("user_id")
  /// Kinds switched off.
  muted     String[] @default([])
  /// Quiet hours (HH:MM) for email and phone alerts, once they arrive.
  quietFrom String?  @map("quiet_from")
  quietTo   String?  @map("quiet_to")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([agencyId, userId])
  @@map("notification_preferences")
}

/// Background work (ADR 0010): written in the same transaction as the change that needs it, claimed by the job runner,
/// retried with back-off and kept as an exception after the last try.
model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  /// One of JOB_NAMES in @gm/shared.
  name        String
  payload     Json      @default("{}")
  /// Business key; the same key is never queued twice for an agency (no double reminders on retry or reschedule).
  key         String?
  /// queued (waiting, or waiting to retry), running, done, failed (an exception after the last try)
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at")
  lockedAt    DateTime? @map("locked_at")
  lastError   String?   @map("last_error")
  result      Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  @@unique([agencyId, key])
  @@index([status, runAt])
  @@index([agencyId, status, createdAt])
  @@map("jobs")
}

// ───────────────────────────── Sales, clients & packages ─────────────────────────────

enum BusinessStage {
  struggle
  survival
  stability
  success
  scale
}

/// Growth OS Client Fitment Map.
enum Fitment {
  amazing
  bread_winning
  convenience
  dangerous
}

/// The agency's sales pipeline (P1-14). Open stages are renamed, added, reordered and removed by the agency;
/// Won and Lost are always there, last. Leads refer to a stage by `key`.
model PipelineStage {
  id          String @id @default(uuid(7)) @db.Uuid
  agencyId    String @map("agency_id") @db.Uuid
  key         String
  name        String
  position    Int
  /// open · won · lost
  kind        String @default("open")
  /// Chance of winning at this stage (0–100), for the weighted pipeline.
  probability Int    @default(0)

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, key])
  @@map("pipeline_stages")
}

model Lead {
  id           String    @id @default(uuid(7)) @db.Uuid
  agencyId     String    @map("agency_id") @db.Uuid
  name         String
  company      String?
  phone        String?
  email        String?
  source       String
  /// Key of one of the agency's pipeline stages.
  stage        String    @default("new")
  /// Expected monthly value in rupees.
  value        Int       @default(0)
  ownerId      String?   @map("owner_id")
  nextFollowUp DateTime? @map("next_follow_up") @db.Date
  notes        String?
  lostReason   String?   @map("lost_reason")
  /// The client this lead became when the deal was won.
  clientId     String?   @map("client_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  activities Activity[]
  proposals  Proposal[]

  @@index([agencyId, stage])
  @@index([agencyId, ownerId])
  @@map("leads")
}

/// A proposal to a lead (P1-16): a package's terms copied when it is made, with a discount. Discounts above the
/// agency's limit wait for someone who may approve; the deal is won from an accepted proposal (P1-17).
model Proposal {
  id              String    @id @default(uuid(7)) @db.Uuid
  agencyId        String    @map("agency_id") @db.Uuid
  leadId          String    @map("lead_id") @db.Uuid
  packageId       String?   @map("package_id") @db.Uuid
  packageName     String    @map("package_name")
  /// The package's fee a month when the proposal was made.
  listFee         Int       @map("list_fee")
  discountPercent Int       @default(0) @map("discount_percent")
  /// Fee a month after the discount.
  monthlyFee      Int       @map("monthly_fee")
  months          Int       @default(12)
  /// Deliverables copied from the package.
  deliverables    Json      @default("[]")
  notes           String?
  /// pending_approval · approved · rejected · sent · accepted · declined
  status          String
  decisionNote    String?   @map("decision_note")
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  sentAt          DateTime? @map("sent_at")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([agencyId, leadId])
  @@index([agencyId, status])
  @@map("proposals")
}

/// Calls, meetings, messages and notes with a lead (P1-15).
model Activity {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  /// call · meeting · whatsapp · email · note
  kind      String
  summary   String
  outcome   String?
  /// When it happened.
  at        DateTime @default(now())
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([agencyId, leadId, at])
  @@map("activities")
}

model Client {
  id               String         @id @default(uuid(7)) @db.Uuid
  agencyId         String         @map("agency_id") @db.Uuid
  /// 2–4 capital letters, used in video codes (KVR-0926-05).
  code             String
  name             String
  industry         String?
  city             String?
  stage            BusinessStage?
  fitment          Fitment?
  health           Int?
  whatsappGroupUrl String?        @map("whatsapp_group_url")
  accountOwnerId   String?        @map("account_owner_id")
  /// Billing details for invoices (P1-20): name on the invoice, GSTIN, GST state code (decides CGST + SGST or IGST), address.
  legalName        String?        @map("legal_name")
  gstin            String?
  state            String?
  billingAddress   String?        @map("billing_address")
  notes            String?
  /// Archived clients leave the lists but keep their history.
  archivedAt       DateTime?      @map("archived_at")
  /// Content pillars: the themes the client's content is planned around (P2-02).
  pillars          String[]       @default([])
  createdAt        DateTime       @default(now()) @map("created_at")

  agency         Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  agreements     Agreement[]
  invoices       Invoice[]
  shoots         Shoot[]
  changeRequests ChangeRequest[]
  responses      QuestionnaireResponse[]
  content        ContentItem[]
  videos         Video[]
  connections    PlatformConnection[]
  projects       Project[]

  @@unique([agencyId, code])
  @@index([agencyId, fitment])
  @@map("clients")
}

model Contact {
  id                  String    @id @default(uuid(7)) @db.Uuid
  agencyId            String    @map("agency_id") @db.Uuid
  clientId            String    @map("client_id") @db.Uuid
  name                String
  title               String?
  email               String?
  phone               String
  approver            Boolean   @default(false)
  /// The contact agreed to get messages on WhatsApp (P3-07); messages go only to contacts who did.
  whatsappOptIn       Boolean   @default(false) @map("whatsapp_opt_in")
  whatsappOptInAt     DateTime? @map("whatsapp_opt_in_at")
  /// How they agreed (or stopped): in their portal, told the team, replied STOP.
  whatsappOptInSource String?   @map("whatsapp_opt_in_source")

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portalLink PortalLink?

  @@index([agencyId, clientId])
  @@map("contacts")
}

/// A client contact's private portal link (P3-01): only its hash is kept, replaced or switched off by the team.
model PortalLink {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  contactId   String    @unique @map("contact_id") @db.Uuid
  /// sha256 of the link's token.
  token       String    @unique
  /// The token itself, encrypted (P3-06), so messages the app sends can carry the link.
  tokenSecret String?   @map("token_secret")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([agencyId, clientId])
  @@map("portal_links")
}

/// An agency's own Razorpay account (P3-10): the keys it entered, secrets encrypted (P3-06).
model PaymentConnection {
  id            String    @id @default(uuid(7)) @db.Uuid
  agencyId      String    @unique @map("agency_id") @db.Uuid
  provider      String    @default("razorpay")
  keyId         String    @map("key_id")
  /// Encrypted.
  keySecret     String    @map("key_secret")
  secretHint    String    @map("secret_hint")
  /// Encrypted. Made by the app; the agency pastes it into Razorpay's webhook settings.
  webhookSecret String    @map("webhook_secret")
  /// unchecked · connected · error
  status        String    @default("unchecked")
  lastError     String?   @map("last_error")
  checkedAt     DateTime? @map("checked_at")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("payment_connections")
}

/// A payment received for an invoice (P3-10): one row per provider payment, so a repeated notice never counts twice.
model Payment {
  id                String   @id @default(uuid(7)) @db.Uuid
  agencyId          String   @map("agency_id") @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  provider          String   @default("razorpay")
  providerPaymentId String   @map("provider_payment_id")
  /// Rupees.
  amount            Int
  method            String?
  paidAt            DateTime @map("paid_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([agencyId, providerPaymentId])
  @@index([agencyId, invoiceId])
  @@map("payments")
}

/// An agency's own WhatsApp Business number (P3-07): the Cloud API details it entered, secrets encrypted (P3-06).
model WhatsAppConnection {
  id            String    @id @default(uuid(7)) @db.Uuid
  agencyId      String    @unique @map("agency_id") @db.Uuid
  phoneNumberId String    @map("phone_number_id")
  businessId    String?   @map("business_id")
  displayPhone  String?   @map("display_phone")
  verifiedName  String?   @map("verified_name")
  /// Encrypted.
  accessToken   String    @map("access_token")
  tokenHint     String    @map("token_hint")
  /// Encrypted; checks the signature on what WhatsApp sends us.
  appSecret     String?   @map("app_secret")
  /// Pasted into Meta's webhook settings; Meta sends it back when it checks the address.
  verifyToken   String    @map("verify_token")
  /// unchecked · connected · error
  status        String    @default("unchecked")
  lastError     String?   @map("last_error")
  checkedAt     DateTime? @map("checked_at")
  /// No messages to clients between these times (India), unless the agency changes them.
  quietFrom     String    @default("21:00") @map("quiet_from")
  quietTo       String    @default("08:00") @map("quiet_to")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("whatsapp_connections")
}

/// A message template the agency had approved in WhatsApp Manager, registered for one purpose (P3-07).
model WhatsAppTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  /// One of WHATSAPP_PURPOSES in @gm/shared.
  purpose   String
  /// The template's name in WhatsApp Manager.
  name      String
  language  String   @default("en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, purpose])
  @@map("whatsapp_templates")
}

/// Every WhatsApp message sent or received (P3-07): the log, and how a reply finds what it answers.
model WhatsAppMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  /// out · in
  direction   String
  clientId    String?   @map("client_id") @db.Uuid
  contactId   String?   @map("contact_id") @db.Uuid
  phone       String
  /// The template's purpose, or "text" for a free message.
  purpose     String
  template    String?
  /// The template's values, or the text sent or received.
  body        Json      @default("{}")
  /// What it is about: video_version, script, invoice, onboarding, report.
  relatedType String?   @map("related_type")
  relatedId   String?   @map("related_id")
  /// queued · sent · delivered · read · failed · skipped · received
  status      String
  /// Why it was skipped or failed.
  reason      String?
  /// WhatsApp's message id.
  providerId  String?   @map("provider_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  @@unique([agencyId, providerId])
  @@index([agencyId, clientId, createdAt])
  @@index([agencyId, contactId, createdAt])
  @@index([agencyId, status, createdAt])
  @@map("whatsapp_messages")
}

/// Something a client asks the team from the portal (P3-05): an idea, a change, a question.
model ClientRequest {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  contactId   String?   @map("contact_id") @db.Uuid
  contactName String    @map("contact_name")
  /// idea · change · question · other
  kind        String
  text        String
  /// open · answered
  status      String    @default("open")
  answer      String?
  answeredBy  String?   @map("answered_by")
  answeredAt  DateTime? @map("answered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([agencyId, clientId, status])
  @@index([agencyId, status, createdAt])
  @@map("client_requests")
}

model Package {
  id                      String   @id @default(uuid(7)) @db.Uuid
  agencyId                String   @map("agency_id") @db.Uuid
  name                    String
  description             String?
  monthlyFee              Int      @map("monthly_fee")
  /// What the package delivers each month: [{ name: "Reels", perMonth: 8, kind: "video" }, …] (packageInput in @gm/shared).
  deliverables            Json     @default("[]")
  /// Totals kept from `deliverables` (videos; posts and stories) for quotas and reports.
  videosPerMonth          Int      @map("videos_per_month")
  postsPerMonth           Int      @map("posts_per_month")
  shootDays               Int      @map("shoot_days")
  revisionsPerDeliverable Int      @map("revisions_per_deliverable")
  platforms               String[]
  /// Default billing terms for agreements made from it, e.g. "Monthly advance".
  billing                 String?
  /// Archived packages stay on the agreements that use them but cannot be chosen for new ones.
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")

  agency     Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agreements Agreement[]
  proposals  Proposal[]

  @@unique([agencyId, name])
  @@map("packages")
}

enum AgreementStatus {
  draft
  active
  renewal_due
  paused
  ended
}

model Agreement {
  id                      String          @id @default(uuid(7)) @db.Uuid
  agencyId                String          @map("agency_id") @db.Uuid
  clientId                String          @map("client_id") @db.Uuid
  packageId               String?         @map("package_id") @db.Uuid
  title                   String
  status                  AgreementStatus @default(draft)
  startDate               DateTime        @map("start_date") @db.Date
  endDate                 DateTime        @map("end_date") @db.Date
  monthlyFee              Int             @map("monthly_fee")
  billing                 String
  revisionsPerDeliverable Int             @map("revisions_per_deliverable")
  /// What it delivers each month (quotas), copied from the package or proposal when made: never changed by package edits.
  deliverables            Json            @default("[]")
  shootDays               Int             @default(0) @map("shoot_days")
  platforms               String[]        @default([])
  notes                   String?
  /// Why it was paused or ended.
  statusNote              String?         @map("status_note")
  /// The agreement this one renews.
  renewsId                String?         @map("renews_id") @db.Uuid
  signedBy                String?         @map("signed_by")
  signedAt                DateTime?       @map("signed_at")
  createdBy               String?         @map("created_by")
  createdAt               DateTime        @default(now()) @map("created_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  package  Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  cycles   Cycle[]
  invoices Invoice[]
  videos   Video[]

  @@index([agencyId, clientId])
  @@index([agencyId, status])
  @@index([agencyId, renewsId])
  @@map("agreements")
}

/// The agency's invoice details (P1-20): who invoices, from which state, numbering, payment terms and bank details.
model InvoiceSettings {
  agencyId         String   @id @map("agency_id") @db.Uuid
  legalName        String   @map("legal_name")
  gstin            String?
  /// Registered state (GST state code): CGST + SGST for clients in this state, IGST for others.
  state            String
  address          String
  /// Services invoiced: [{ name, sac, rate }] (invoiceService in @gm/shared).
  services         Json     @default("[]")
  /// e.g. GM/{FY}/{0000} (formatInvoiceNumber in @gm/shared).
  numberFormat     String   @map("number_format")
  /// The numbering series the next number belongs to: the financial year when the format shows it, otherwise "all".
  numberSeries     String?  @map("number_series")
  nextNumber       Int      @default(1) @map("next_number")
  paymentTermsDays Int      @default(7) @map("payment_terms_days")
  /// Each agreement's invoice is drafted by itself on its billing day (P5-04).
  autoDraft        Boolean  @default(true) @map("auto_draft")
  bankName         String?  @map("bank_name")
  accountName      String?  @map("account_name")
  accountNumber    String?  @map("account_number")
  ifsc             String?
  upiId            String?  @map("upi_id")
  footer           String?
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("invoice_settings")
}

/// A GST invoice (P1-20). Drafts have no number; issuing numbers it and keeps a copy of the seller's and client's
/// details, so later changes to either never alter an issued invoice.
model Invoice {
  id            String    @id @default(uuid(7)) @db.Uuid
  agencyId      String    @map("agency_id") @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  agreementId   String?   @map("agreement_id") @db.Uuid
  /// Set when issued.
  number        String?
  /// draft · sent · paid · cancelled
  status        String    @default("draft")
  /// The month billed (YYYY-MM), for agreement invoices.
  period        String?
  issueDate     DateTime? @map("issue_date") @db.Date
  dueDate       DateTime? @map("due_date") @db.Date
  /// GST state code of the place of supply (the client's state).
  placeOfSupply String?   @map("place_of_supply")
  /// [{ description, sac, quantity, rate, taxRate }] (invoiceLine in @gm/shared).
  lines         Json      @default("[]")
  taxable       Int       @default(0)
  cgst          Int       @default(0)
  sgst          Int       @default(0)
  igst          Int       @default(0)
  total         Int       @default(0)
  /// The client's billing details when issued: { name, gstin, state, address }.
  billedTo      Json?     @map("billed_to")
  /// The agency's invoice details when issued.
  seller        Json?
  notes         String?
  sentAt        DateTime? @map("sent_at")
  paidOn        DateTime? @map("paid_on") @db.Date
  paymentNote   String?   @map("payment_note")
  /// The online payment link (P3-10): made through the agency's own Razorpay when the invoice is issued.
  payLinkId     String?   @map("pay_link_id")
  payLinkUrl    String?   @map("pay_link_url")
  /// created · paid · cancelled · failed
  payLinkStatus String?   @map("pay_link_status")
  payLinkError  String?   @map("pay_link_error")
  cancelReason  String?   @map("cancel_reason")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  agreement Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  @@unique([agencyId, number])
  @@index([agencyId, status])
  @@index([agencyId, clientId])
  @@index([agencyId, agreementId, period])
  @@map("invoices")
}

enum CycleStatus {
  upcoming
  in_progress
  reconciling
  closed
}

/// One month of an agreement: what was promised, what was delivered.
model Cycle {
  id           String      @id @default(uuid(7)) @db.Uuid
  agencyId     String      @map("agency_id") @db.Uuid
  agreementId  String      @map("agreement_id") @db.Uuid
  month        DateTime    @db.Date
  status       CycleStatus @default(upcoming)
  /// Videos promised this month (the agreement's video deliverables, plus any carried in).
  promised     Int
  /// Videos delivered (approved or published), kept when the month is closed.
  delivered    Int         @default(0)
  /// Videos carried in from the previous month's shortfall.
  carriedIn    Int         @default(0) @map("carried_in")
  /// carry · credit · forfeit: what happens to a shortfall when the month is closed (P2-01).
  decision     String?
  decisionNote String?     @map("decision_note")
  /// Credit note (₹) when the shortfall is credited.
  credit       Int?
  closedBy     String?     @map("closed_by")
  closedAt     DateTime?   @map("closed_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  videos    Video[]

  @@unique([agreementId, month])
  @@index([agencyId, status])
  @@map("cycles")
}

// ───────────────────────────── Onboarding engine ─────────────────────────────

enum QuestionnaireKind {
  client
  agency
}

/// The agency's onboarding questions (P1-21). Edits go into one draft per kind; publishing makes it the next version.
/// Responses keep the version they were started on.
model QuestionnaireTemplate {
  id          String            @id @default(uuid(7)) @db.Uuid
  agencyId    String            @map("agency_id") @db.Uuid
  kind        QuestionnaireKind
  /// 1, 2, 3… (a draft carries the number it will be published as).
  version     String
  windowDays  Int               @default(7) @map("window_days")
  /// Sections, questions and checklist, validated by @gm/shared questionnaireDefinition.
  definition  Json
  isDefault   Boolean           @default(false) @map("is_default")
  /// Null while it is the draft.
  publishedAt DateTime?         @map("published_at")
  createdBy   String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  responses QuestionnaireResponse[]

  @@unique([agencyId, kind, version])
  @@map("questionnaire_templates")
}

model QuestionnaireResponse {
  id              String    @id @default(uuid(7)) @db.Uuid
  agencyId        String    @map("agency_id") @db.Uuid
  templateId      String    @map("template_id") @db.Uuid
  /// Null for the agency's own questionnaire.
  clientId        String?   @map("client_id") @db.Uuid
  /// SHA-256 of the private link's token: the link itself is shown only when it is made.
  token           String    @unique
  /// The token itself, encrypted (P3-06), so reminders the app sends can carry the link.
  tokenSecret     String?   @map("token_secret")
  /// link · assisted
  mode            String    @default("link")
  /// The language the client sees it in (one of the agency's languages).
  language        String    @default("en")
  /// When the window starts: the link was shared, or the assisted call began.
  sentAt          DateTime? @map("sent_at")
  requiredDoneAt  DateTime? @map("required_done_at")
  completedAt     DateTime? @map("completed_at")
  /// Checklist items ticked by hand: { key: { at, by } }.
  checklist       Json      @default("{}")
  /// Production allowed to start before onboarding is complete (onboarding: approve), with the reason.
  exceptionReason String?   @map("exception_reason")
  exceptionBy     String?   @map("exception_by")
  exceptionAt     DateTime? @map("exception_at")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  template  QuestionnaireTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  client    Client?                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  answers   Answer[]
  reminders QuestionnaireReminder[]

  @@index([agencyId, clientId])
  @@map("questionnaire_responses")
}

model Answer {
  id          String   @id @default(uuid(7)) @db.Uuid
  agencyId    String   @map("agency_id") @db.Uuid
  responseId  String   @map("response_id") @db.Uuid
  questionKey String   @map("question_key")
  value       Json
  answeredBy  String?  @map("answered_by")
  answeredAt  DateTime @default(now()) @map("answered_at")

  response QuestionnaireResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionKey])
  @@map("answers")
}

model QuestionnaireReminder {
  id         String   @id @default(uuid(7)) @db.Uuid
  agencyId   String   @map("agency_id") @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  /// The day of the window it was due on (from the agency's reminder days).
  day        Int
  /// whatsapp · email · in_app
  channel    String
  sentAt     DateTime @default(now()) @map("sent_at")
  sentBy     String?  @map("sent_by")

  response QuestionnaireResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, day])
  @@index([agencyId, responseId])
  @@map("questionnaire_reminders")
}

// ───────────────────────────── Content ─────────────────────────────

enum ContentStage {
  idea
  topic
  research
  script
  approval
  ready
}

model TopicList {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  month       DateTime  @db.Date
  needed      Int
  /// draft · sent · confirmed
  status      String    @default("draft")
  sentAt      DateTime? @map("sent_at")
  confirmedAt DateTime? @map("confirmed_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([clientId, month])
  @@index([agencyId, status])
  @@map("topic_lists")
}

model ContentItem {
  id        String       @id @default(uuid(7)) @db.Uuid
  agencyId  String       @map("agency_id") @db.Uuid
  clientId  String       @map("client_id") @db.Uuid
  title     String
  pillar    String
  format    String
  source    String
  stage     ContentStage @default(idea)
  ownerId   String?      @map("owner_id")
  month     DateTime     @db.Date
  due       DateTime?    @db.Date
  /// Client's choice on the monthly topic list: picked | skipped.
  pick      String?
  notes     String       @default("")
  /// Research notes: facts, references and hooks (P2-04).
  research  String       @default("")
  links     Json         @default("[]")
  createdBy String?      @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  versions ScriptVersion[]
  video    Video?

  @@index([agencyId, clientId, month])
  @@index([agencyId, stage])
  @@map("content_items")
}

model ScriptVersion {
  id            String    @id @default(uuid(7)) @db.Uuid
  agencyId      String    @map("agency_id") @db.Uuid
  contentItemId String    @map("content_item_id") @db.Uuid
  number        Int
  hook          String
  body          String
  cta           String
  onScreen      String    @default("") @map("on_screen")
  /// draft · review · sent · changes · approved
  status        String    @default("draft")
  clientNote    String?   @map("client_note")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  sentAt        DateTime? @map("sent_at")
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, number])
  @@map("script_versions")
}

// ───────────────────────────── Production ─────────────────────────────

enum VideoStage {
  planned
  scripting
  shoot_scheduled
  shot
  editing
  internal_qc
  client_review
  revision
  approved
  published
}

model Video {
  id             String     @id @default(uuid(7)) @db.Uuid
  agencyId       String     @map("agency_id") @db.Uuid
  clientId       String     @map("client_id") @db.Uuid
  cycleId        String?    @map("cycle_id") @db.Uuid
  contentItemId  String?    @unique @map("content_item_id") @db.Uuid
  /// KVR-0926-05: client code, month-year, running number.
  code           String
  title          String
  format         String
  aspect         String
  urgency        String     @default("standard")
  stage          VideoStage @default(planned)
  editorId       String?    @map("editor_id")
  dueDate        DateTime?  @map("due_date") @db.Date
  publishDate    DateTime?  @map("publish_date") @db.Date
  revisionsUsed  Int        @default(0) @map("revisions_used")
  /// { step: { by, at } } for the edit steps done (P2-09).
  editSteps      Json       @default("{}") @map("edit_steps")
  /// { check: { result: pass|fail, note, by, at } } (P2-10).
  qc             Json       @default("{}")
  agreementId    String?    @map("agreement_id") @db.Uuid
  /// Camera clip numbers, e.g. C0012–C0019.
  clipNo         String?    @map("clip_no")
  /// Footage backed up and verified (VP).
  protectedAt    DateTime?  @map("protected_at")
  protectedBy    String?    @map("protected_by")
  directorId     String?    @map("director_id")
  cameraId       String?    @map("camera_id")
  shootId        String?    @map("shoot_id") @db.Uuid
  /// Editing time planned (from the format); time logged beyond it needs a reason.
  plannedMinutes Int        @default(0) @map("planned_minutes")
  delayReason    String?    @map("delay_reason")
  platforms      String[]   @default([])
  notes          String?
  createdBy      String?    @map("created_by")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")

  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  cycle          Cycle?             @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  agreement      Agreement?         @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  shoot          Shoot?             @relation(fields: [shootId], references: [id], onDelete: SetNull)
  contentItem    ContentItem?       @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  versions       VideoVersion[]
  changeRequests ChangeRequest[]
  posts          ScheduledPost[]
  stageChanges   VideoStageChange[]
  timeLogs       VideoTimeLog[]

  @@unique([agencyId, code])
  @@index([agencyId, stage])
  @@index([agencyId, clientId, dueDate])
  @@map("videos")
}

model VideoVersion {
  id        String    @id @default(uuid(7)) @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  videoId   String    @map("video_id") @db.Uuid
  label     String
  number    Int       @default(1)
  /// internal · sent · changes_requested · approved
  status    String
  duration  String?
  notes     String?
  fileId    String?   @map("file_id") @db.Uuid
  /// Or a link to the file (Drive, Frame.io…).
  link      String?
  sentAt    DateTime? @map("sent_at")
  decidedAt DateTime? @map("decided_at")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  video    Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  comments ReviewComment[]

  @@unique([videoId, label])
  @@map("video_versions")
}

model ReviewComment {
  id           String   @id @default(uuid(7)) @db.Uuid
  agencyId     String   @map("agency_id") @db.Uuid
  versionId    String   @map("version_id") @db.Uuid
  author       String
  timestampSec Int?     @map("timestamp_sec")
  text         String
  kind         String   @default("text")
  resolved     Boolean  @default(false)
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  version VideoVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([agencyId, versionId])
  @@map("review_comments")
}

enum RevisionKind {
  agency_correction
  included_revision
  change_request
}

/// Feedback on a delivered video, classified (P2-11): our correction, an included revision (uses the allowance), or a
/// change request (new work, estimated and approved by the client before it is done).
model ChangeRequest {
  id             String       @id @default(uuid(7)) @db.Uuid
  agencyId       String       @map("agency_id") @db.Uuid
  clientId       String?      @map("client_id") @db.Uuid
  videoId        String?      @map("video_id") @db.Uuid
  /// The version the feedback was given on.
  versionId      String?      @map("version_id") @db.Uuid
  kind           RevisionKind
  summary        String
  /// Change requests: the estimate (₹, before GST) and the days it adds.
  estimate       Int?
  dateImpactDays Int?         @map("date_impact_days")
  /// open · awaiting_client · approved · rejected · done
  status         String       @default("open")
  decidedAt      DateTime?    @map("decided_at")
  createdBy      String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  video  Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@map("change_requests")
}

/// Each agency's production settings (P2-06 to P2-10): the video code format and every checklist, starting from the
/// Growth OS defaults in @gm/shared and edited in Settings → Production.
model ProductionSettings {
  agencyId        String   @id @map("agency_id") @db.Uuid
  /// e.g. {CLIENT}-{MM}{YY}-{00} → KVR-0926-05
  videoCodeFormat String   @map("video_code_format")
  /// [{ name, minutes }]: video formats and the editing time planned for each.
  formats         Json
  /// The edit steps, in order.
  editSteps       Json     @map("edit_steps")
  /// [{ key, label, hint }]: the internal quality checks.
  qcChecks        Json     @map("qc_checks")
  /// [{ key, name, items }]: kit lists for shoots.
  kits            Json
  /// Things to check before a shoot starts.
  preShoot        Json     @map("pre_shoot")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("production_settings")
}

/// Every stage move of a video, with who moved it (P2-08).
model VideoStageChange {
  id       String      @id @default(uuid(7)) @db.Uuid
  agencyId String      @map("agency_id") @db.Uuid
  videoId  String      @map("video_id") @db.Uuid
  from     VideoStage?
  to       VideoStage
  note     String?
  by       String?
  at       DateTime    @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([agencyId, videoId])
  @@map("video_stage_changes")
}

/// Time spent on a video (P2-13), mostly editing.
model VideoTimeLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  userId    String   @map("user_id")
  date      DateTime @db.Date
  minutes   Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([agencyId, videoId])
  @@index([agencyId, userId, date])
  @@map("video_time_logs")
}

/// Time spent on a shoot day (P2-13): travel, set-up, shooting, kit back.
model ShootTimeLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  shootId   String   @map("shoot_id") @db.Uuid
  userId    String   @map("user_id")
  date      DateTime @db.Date
  minutes   Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  shoot Shoot @relation(fields: [shootId], references: [id], onDelete: Cascade)

  @@index([agencyId, shootId])
  @@index([agencyId, userId, date])
  @@map("shoot_time_logs")
}

/// A shoot day (P2-06): the crew, the kit going out and coming back, signatures, and the videos shot.
model Shoot {
  id         String   @id @default(uuid(7)) @db.Uuid
  agencyId   String   @map("agency_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  title      String
  date       DateTime @db.Date
  callTime   String?  @map("call_time")
  location   String?
  batchNo    String?  @map("batch_no")
  /// Key of one of the agency's kit lists.
  kit        String
  cameraId   String?  @map("camera_id")
  directorId String?  @map("director_id")
  /// planned · packed · on_shoot · returned · closed
  status     String   @default("planned")
  notes      String?
  /// { item: { packed, shot, received } }
  kitTicks   Json     @default("{}") @map("kit_ticks")
  /// { item: true }
  preShoot   Json     @default("{}") @map("pre_shoot")
  /// { giver: { by, at }, receiver: { by, at }, client: { name, at } }
  signatures Json     @default("{}")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  videos    Video[]
  incidents ShootIncident[]
  timeLogs  ShootTimeLog[]

  @@index([agencyId, date])
  @@map("shoots")
}

/// Kit that did not come back, or anything else that went wrong on a shoot.
model ShootIncident {
  id         String    @id @default(uuid(7)) @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  shootId    String    @map("shoot_id") @db.Uuid
  items      String[]  @default([])
  note       String
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  shoot Shoot @relation(fields: [shootId], references: [id], onDelete: Cascade)

  @@index([agencyId, shootId])
  @@map("shoot_incidents")
}

// ───────────────────────────── Publishing & messaging ─────────────────────────────

model PlatformConnection {
  id             String    @id @default(uuid(7)) @db.Uuid
  agencyId       String    @map("agency_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  /// instagram | facebook | youtube | linkedin | x | threads | pinterest | gbp
  platform       String
  handle         String
  /// manual · linked · choose · expired · error (P3-11)
  status         String    @default("manual")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  /// The platform account it posts to (Instagram account, Facebook Page or YouTube channel) and its name.
  externalId     String?   @map("external_id")
  externalName   String?   @map("external_name")
  /// Encrypted. Never shown back.
  accessToken    String?   @map("access_token")
  /// Encrypted (YouTube).
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  /// Encrypted: the sign-in and the accounts it gave, while the team chooses one.
  pending        String?
  /// Scheduled posts go out by themselves at their time.
  autoPublish    Boolean   @default(true) @map("auto_publish")
  lastError      String?   @map("last_error")
  linkedAt       DateTime? @map("linked_at")
  linkedBy       String?   @map("linked_by")

  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts  ScheduledPost[]

  @@unique([clientId, platform])
  @@map("platform_connections")
}

model ScheduledPost {
  id           String    @id @default(uuid(7)) @db.Uuid
  agencyId     String    @map("agency_id") @db.Uuid
  videoId      String    @map("video_id") @db.Uuid
  connectionId String    @map("connection_id") @db.Uuid
  scheduledAt  DateTime  @map("scheduled_at")
  /// scheduled · publishing · published · failed
  status       String    @default("scheduled")
  publishedUrl String?   @map("published_url")
  /// manual · connector (posted by the app, P3-11)
  publishedVia String    @default("manual") @map("published_via")
  /// The platform's id for the post (or, while Instagram processes it, for the upload).
  externalId   String?   @map("external_id")
  publishError String?   @map("publish_error")
  publishedAt  DateTime? @map("published_at")
  proofFileId  String?   @map("proof_file_id") @db.Uuid
  caption      String?
  publishedBy  String?   @map("published_by")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  video      Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  connection PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  metric     PostMetric?

  @@index([agencyId, scheduledAt])
  @@map("scheduled_posts")
}

/// The latest numbers for a published post (P3-09): entered by the team, or brought in by a platform connection.
model PostMetric {
  id         String   @id @default(uuid(7)) @db.Uuid
  agencyId   String   @map("agency_id") @db.Uuid
  postId     String   @unique @map("post_id") @db.Uuid
  views      Int?
  reach      Int?
  likes      Int?
  comments   Int?
  shares     Int?
  saves      Int?
  /// manual · connector
  source     String   @default("manual")
  recordedAt DateTime @default(now()) @map("recorded_at")
  recordedBy String?  @map("recorded_by")

  post ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_metrics")
}

/// A client's monthly report (P3-09): the month as it stood, the team's note, released to the client's portal.
model MonthlyReport {
  id         String    @id @default(uuid(7)) @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  month      DateTime  @db.Date
  /// draft · released
  status     String    @default("draft")
  /// MonthlyReportData in @gm/shared, as of when it was made or last refreshed; kept as it is once released.
  data       Json      @default("{}")
  note       String?
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  releasedAt DateTime? @map("released_at")
  releasedBy String?   @map("released_by")

  @@unique([agencyId, clientId, month])
  @@index([agencyId, month])
  @@map("monthly_reports")
}

// ───────────────────────────── STOP reviews ─────────────────────────────

enum ReviewCadence {
  daily
  weekly
  tactical
  strategic
}

/// A STOP review rhythm as the agency runs it (P5-14): its agenda, people, and the figures it looks at.
model ReviewCadenceSetting {
  id             String        @id @default(uuid(7)) @db.Uuid
  agencyId       String        @map("agency_id") @db.Uuid
  cadence        ReviewCadence
  name           String
  everyDays      Int           @map("every_days")
  purpose        String        @default("")
  minutes        Int
  schedule       String        @default("")
  mandatory      Boolean       @default(false)
  facilitatorId  String?       @map("facilitator_id")
  participantIds String[]      @map("participant_ids")
  /// [{ title, minutes, note }]
  agenda         Json          @default("[]")
  blocks         String[]

  @@unique([agencyId, cadence])
  @@map("review_cadences")
}

/// A review meeting (P5-14): attendance, notes against the agenda, recognitions, and the figures as they were when locked.
model Meeting {
  id             String        @id @default(uuid(7)) @db.Uuid
  agencyId       String        @map("agency_id") @db.Uuid
  cadence        ReviewCadence
  number         Int
  title          String
  startsAt       DateTime      @map("starts_at")
  /// scheduled · locked
  status         String        @default("scheduled")
  lockedAt       DateTime?     @map("locked_at")
  lockedBy       String?       @map("locked_by")
  venue          String?
  facilitatorId  String?       @map("facilitator_id")
  participantIds String[]      @default([]) @map("participant_ids")
  /// The agenda as it was when scheduled.
  agenda         Json          @default("[]")
  /// { agendaIndex: text }
  notes          Json          @default("{}")
  /// { userId: present | late | absent }
  attendance     Json          @default("{}")
  /// [{ personId, title, story, by }]
  recognitions   Json          @default("[]")
  /// The figures reviewed, kept as they were when it was locked.
  snapshot       Json?
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")

  commitments Commitment[]
  decisions   Decision[]

  @@unique([agencyId, cadence, number])
  @@index([agencyId, startsAt])
  @@map("meetings")
}

/// A commitment (P5-16): what an owner will do by a day, marked breakthrough or breakdown at each review and carried
/// forward until done.
model Commitment {
  id        String    @id @default(uuid(7)) @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  /// The meeting it was made in, when it was.
  meetingId String?   @map("meeting_id") @db.Uuid
  text      String
  ownerId   String?   @map("owner_id")
  due       DateTime? @db.Date
  /// open · done
  status    String    @default("open")
  /// BT (breakthrough) | BD (breakdown): the last mark.
  mark      String?
  markNote  String?   @map("mark_note")
  carried   Int       @default(0)
  /// [{ mark, note, at, meetingId }]
  history   Json      @default("[]")
  doneAt    DateTime? @map("done_at")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([agencyId, status])
  @@map("commitments")
}

/// A decision (P5-16), in a review or on its own, with who carries it out.
model Decision {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  meetingId String?  @map("meeting_id") @db.Uuid
  text      String
  ownerId   String?  @map("owner_id")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@map("decisions")
}

// ───────────────────────────── Genie Assistant ─────────────────────────────

/// Genie Assistant's rules as each agency set them (P4-01): on or off, and each rule's threshold.
model GenieSettings {
  agencyId      String    @id @map("agency_id") @db.Uuid
  /// { ruleKey: { enabled, threshold } } — anything not set uses the rule's default.
  rules         Json      @default("{}")
  lastRunAt     DateTime? @map("last_run_at")
  /// Drafting and Ask Genie use the model only once the agency switches them on (P4-05).
  aiEnabled     Boolean   @default(false) @map("ai_enabled")
  /// The agency's own monthly limit on AI usage, in rupees (P4-09).
  monthlyBudget Int       @default(2000) @map("monthly_budget")
  /// Days drafts' prompts and Ask Genie conversations are kept (P4-10).
  retentionDays Int       @default(90) @map("retention_days")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("genie_settings")
}

/// Something a rule found (P4-02): one per finding, open until someone acts on it or the rule no longer finds it.
model Insight {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  rule        String
  /// The rule and the record (and period) it is about, so a finding is never raised twice.
  dedupeKey   String    @map("dedupe_key")
  /// info · warning · critical
  severity    String
  title       String
  body        String?
  /// Who may see it: people who may view this area.
  area        String
  entity      String?
  entityId    String?   @map("entity_id")
  clientId    String?   @map("client_id") @db.Uuid
  link        String?
  /// Who should act on it.
  ownerId     String?   @map("owner_id")
  evidence    Json      @default("{}")
  /// open · done · dismissed · resolved
  status      String    @default("open")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  resolvedAt  DateTime? @map("resolved_at")
  decidedBy   String?   @map("decided_by")
  decidedAt   DateTime? @map("decided_at")

  @@unique([agencyId, dedupeKey])
  @@index([agencyId, status])
  @@map("insights")
}

/// A draft written by the model for a person to approve, edit or reject (P4-06): a WhatsApp nudge, a caption, content
/// ideas or a report summary. What was approved, and how much it was edited, is kept.
model Draft {
  id        String    @id @default(uuid(7)) @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  /// nudge · caption · ideas · report_summary
  kind      String
  /// draft · approved · rejected
  status    String    @default("draft")
  /// What it is for: insight, video, client or report, and its id.
  entity    String
  entityId  String    @map("entity_id")
  clientId  String?   @map("client_id") @db.Uuid
  /// What the person asked for (notes, platform…).
  request   Json      @default("{}")
  /// The prompt's context, kept for the agency's retention period then cleared.
  context   String?
  /// What the model wrote.
  output    Json
  /// What was approved (after any edits).
  final     Json?
  /// How much of the draft the person changed, 0 to 100.
  editedPct Int?      @map("edited_pct")
  /// claude · stand-in
  source    String
  model     String?
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  decidedBy String?   @map("decided_by")
  decidedAt DateTime? @map("decided_at")

  @@index([agencyId, entity, entityId])
  @@index([agencyId, kind, status])
  @@map("drafts")
}

/// One call to the model (P4-09): which feature, who asked, tokens and what it cost the agency.
model AiUsage {
  id               String   @id @default(uuid(7)) @db.Uuid
  agencyId         String   @map("agency_id") @db.Uuid
  /// nudge · caption · ideas · report_summary · ask
  feature          String
  userId           String?  @map("user_id")
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  /// What it cost, in paise.
  costPaise        Int      @map("cost_paise")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([agencyId, createdAt])
  @@map("ai_usage")
}

/// An Ask Genie conversation (P4-08): one person's questions and the answers, kept for the agency's retention period.
model AskConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  messages AskMessage[]

  @@index([agencyId, userId, updatedAt])
  @@map("ask_conversations")
}

model AskMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  agencyId       String   @map("agency_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// user · assistant
  role           String
  content        String
  /// The records the answer drew on: [{ label, href }].
  sources        Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([agencyId, conversationId])
  @@map("ask_messages")
}

// ───────────────────────────── Finance and costing ─────────────────────────────

/// What an hour of a person's time costs the agency (P5-01), from a day on: the rate in force on a day is the latest
/// that started by then. Restricted like salaries.
model PersonCostRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  agencyId      String   @map("agency_id") @db.Uuid
  userId        String   @map("user_id")
  /// What the person costs the agency a month, in rupees (salary and what goes with it).
  monthlyCost   Int      @map("monthly_cost")
  /// The working hours that cost covers.
  hoursPerMonth Int      @default(176) @map("hours_per_month")
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([agencyId, userId, effectiveFrom])
  @@index([agencyId, userId])
  @@map("person_cost_rates")
}

/// The agency's costing settings (P5-01): each kit's day rate and the month's overheads not booked as expenses.
model CostSettings {
  agencyId        String   @id @map("agency_id") @db.Uuid
  /// { kitKey: rupees a shoot day }
  kitRates        Json     @default("{}") @map("kit_rates")
  /// Rupees a month: rent, software, utilities and the like.
  monthlyOverhead Int      @default(0) @map("monthly_overhead")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("cost_settings")
}

model Vendor {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  name      String
  gstin     String?
  phone     String?
  category  String?
  createdAt DateTime @default(now()) @map("created_at")

  expenses Expense[]

  @@unique([agencyId, name])
  @@map("vendors")
}

/// Money the agency spent (P5-02): submitted with a receipt, approved by finance, and allocated to a video, to a
/// client (shared across its videos) or to overheads (neither).
model Expense {
  id           String    @id @default(uuid(7)) @db.Uuid
  agencyId     String    @map("agency_id") @db.Uuid
  date         DateTime  @db.Date
  vendorId     String?   @map("vendor_id") @db.Uuid
  category     String
  description  String
  /// Rupees before GST, and the GST on it.
  amount       Int
  gst          Int       @default(0)
  /// submitted · approved · rejected
  status       String    @default("submitted")
  videoId      String?   @map("video_id") @db.Uuid
  clientId     String?   @map("client_id") @db.Uuid
  submittedBy  String?   @map("submitted_by")
  decidedBy    String?   @map("decided_by")
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note")
  createdAt    DateTime  @default(now()) @map("created_at")

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([agencyId, date])
  @@index([agencyId, status])
  @@map("expenses")
}

/// A month's books (P5-05): closed once checked, with its figures kept as they were; time and expenses dated in a
/// closed month cannot change until it is reopened (with a reason).
model FinancialPeriod {
  id           String    @id @default(uuid(7)) @db.Uuid
  agencyId     String    @map("agency_id") @db.Uuid
  month        DateTime  @db.Date
  /// closed · open (reopened)
  status       String    @default("closed")
  /// The month's figures when it was closed (FinanceMonthRow in @gm/shared).
  figures      Json      @default("{}")
  closedBy     String?   @map("closed_by")
  closedAt     DateTime  @default(now()) @map("closed_at")
  reopenedBy   String?   @map("reopened_by")
  reopenedAt   DateTime? @map("reopened_at")
  reopenReason String?   @map("reopen_reason")

  @@unique([agencyId, month])
  @@map("financial_periods")
}

// ───────────────────────────── People ─────────────────────────────

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  name      String
  headId    String?  @map("head_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([agencyId, name])
  @@map("departments")
}

/// A team member's employee record (P5-06). Personal details are for HR; bank account and PAN are encrypted and for
/// payroll only.
model EmployeeProfile {
  id              String    @id @default(uuid(7)) @db.Uuid
  agencyId        String    @map("agency_id") @db.Uuid
  userId          String    @map("user_id")
  /// The code the attendance device and payroll use.
  employeeCode    String?   @map("employee_code")
  departmentId    String?   @map("department_id") @db.Uuid
  designation     String?
  /// full_time · part_time · intern · freelancer
  employmentType  String    @default("full_time") @map("employment_type")
  joiningDate     DateTime? @map("joining_date") @db.Date
  exitDate        DateTime? @map("exit_date") @db.Date
  phone           String?
  personalEmail   String?   @map("personal_email")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  address         String?
  emergencyName   String?   @map("emergency_name")
  emergencyPhone  String?   @map("emergency_phone")
  /// Encrypted; the last digits are kept apart to show.
  bankAccount     String?   @map("bank_account")
  bankHint        String?   @map("bank_hint")
  ifsc            String?
  /// Encrypted.
  pan             String?
  panHint         String?   @map("pan_hint")
  uan             String?
  esiNumber       String?   @map("esi_number")
  /// Who they report to: their manager reviews their month (P5-11).
  managerId       String?   @map("manager_id")
  /// The KRAs their month is scored on (P5-11).
  kraTemplateId   String?   @map("kra_template_id") @db.Uuid
  /// The daily data sheet they fill in (P5-12).
  sheetTemplateId String?   @map("sheet_template_id") @db.Uuid
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, userId])
  @@unique([agencyId, employeeCode])
  @@map("employee_profiles")
}

/// The agency's attendance rules (P5-07).
model AttendanceSettings {
  agencyId     String   @id @map("agency_id") @db.Uuid
  /// 24-hour time the working day starts.
  workdayStart String   @default("09:30") @map("workday_start")
  /// Minutes after the start that count as late.
  lateAfter    Int      @default(15) @map("late_after")
  /// Fewer minutes than this between first in and last out is a half day.
  halfDayBelow Int      @default(240) @map("half_day_below")
  /// Days of the week off: 0 Sunday … 6 Saturday.
  weeklyOffs   Int[]    @default([0]) @map("weekly_offs")
  /// [{ date: "2026-10-20", name: "Deepavali" }]
  holidays     Json     @default("[]")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("attendance_settings")
}

/// One person's day (P5-07): from the attendance export, a correction, or approved leave.
model AttendanceRecord {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  userId    String   @map("user_id")
  date      DateTime @db.Date
  firstIn   String?  @map("first_in")
  lastOut   String?  @map("last_out")
  minutes   Int      @default(0)
  /// present · late · half_day · absent · leave · holiday · weekly_off
  status    String
  /// import · correction · leave
  source    String   @default("import")
  importId  String?  @map("import_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, userId, date])
  @@index([agencyId, date])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id        String    @id @default(uuid(7)) @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  userId    String    @map("user_id")
  date      DateTime  @db.Date
  firstIn   String?   @map("first_in")
  lastOut   String?   @map("last_out")
  reason    String
  /// pending · approved · rejected
  state     String    @default("pending")
  decidedBy String?   @map("decided_by")
  decidedAt DateTime? @map("decided_at")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([agencyId, state])
  @@map("attendance_corrections")
}

/// The agency's own kinds of leave (P5-08).
model LeaveType {
  id           String   @id @default(uuid(7)) @db.Uuid
  agencyId     String   @map("agency_id") @db.Uuid
  name         String
  /// Days a year; 0 means no limit (e.g. unpaid leave).
  daysPerYear  Int      @map("days_per_year")
  paid         Boolean  @default(true)
  /// Unused days that carry into the next year, at most.
  carryForward Int      @default(0) @map("carry_forward")
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  requests LeaveRequest[]

  @@unique([agencyId, name])
  @@map("leave_types")
}

model LeaveRequest {
  id        String    @id @default(uuid(7)) @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  userId    String    @map("user_id")
  typeId    String    @map("type_id") @db.Uuid
  from      DateTime  @db.Date
  to        DateTime  @db.Date
  halfDay   Boolean   @default(false) @map("half_day")
  /// Working days it takes (weekly offs and holidays are not counted).
  days      Float
  reason    String
  /// pending · approved · rejected · cancelled
  status    String    @default("pending")
  decidedBy String?   @map("decided_by")
  decidedAt DateTime? @map("decided_at")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  type LeaveType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([agencyId, userId])
  @@index([agencyId, status])
  @@map("leave_requests")
}

// ───────────────────────────── Payroll ─────────────────────────────

/// A person's monthly salary from a day on, in parts (P5-09); on each day, the latest that started by then applies.
/// Restricted to those who may see salaries.
model SalaryStructure {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  userId    String   @map("user_id")
  from      DateTime @db.Date
  /// [{ name, amount }]: rupees a month.
  earnings  Json
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([agencyId, userId, from])
  @@map("salary_structures")
}

/// The agency's payroll rules (P5-09): what a day's pay is, lateness, and its own deductions — never assumed.
model PayrollSettings {
  agencyId        String   @id @map("agency_id") @db.Uuid
  /// calendar · working · thirty
  dayBasis        String   @default("calendar") @map("day_basis")
  latesPerHalfDay Int?     @map("lates_per_half_day")
  /// The agency's deductions and contributions, as its auditor sets them.
  deductions      Json     @default("[]")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("payroll_settings")
}

/// A month's payroll (P5-09): a draft worked out from attendance and leave, then locked — when each person's payslip
/// is theirs to see and the month's attendance stops changing.
model PayrollRun {
  id        String    @id @default(uuid(7)) @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  /// YYYY-MM
  month     String
  /// draft · locked
  status    String    @default("draft")
  /// People left out, and things worth a look.
  notes     Json      @default("[]")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  lockedBy  String?   @map("locked_by")
  lockedAt  DateTime? @map("locked_at")
  payslips  Payslip[]

  @@unique([agencyId, month])
  @@map("payroll_runs")
}

/// One person's pay for a month (P5-09), as worked out and as payroll changed it.
model Payslip {
  id              String     @id @default(uuid(7)) @db.Uuid
  agencyId        String     @map("agency_id") @db.Uuid
  runId           String     @map("run_id") @db.Uuid
  userId          String     @map("user_id")
  /// Who they were that month: name, code, designation, department, bank and PAN hints, UAN.
  person          Json
  /// The basis, days with the agency, days without pay and why, days paid.
  days            Json
  earnings        Json
  deductions      Json
  /// Paid by the agency on top of the salary.
  contributions   Json       @default("[]")
  adjustments     Json       @default("[]")
  /// Amounts entered this month for deductions entered for each person (such as TDS).
  entries         Json       @default("{}")
  extraLop        Float      @default(0) @map("extra_lop")
  gross           Int
  totalDeductions Int        @map("total_deductions")
  net             Int
  employerCost    Int        @default(0) @map("employer_cost")
  notes           Json       @default("[]")
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([agencyId, userId])
  @@map("payslips")
}

// ───────────────────────────── Hiring ─────────────────────────────

/// The agency's hiring rule (P5-10): what a scorecard recommends, and where candidates come from.
model HiringSettings {
  agencyId  String   @id @map("agency_id") @db.Uuid
  /// { hireEach, hireTotal, hireTask, holdTotal, holdTask, sources }
  rule      Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("hiring_settings")
}

/// An opening and the role's task document (P5-10).
model Opening {
  id              String      @id @default(uuid(7)) @db.Uuid
  agencyId        String      @map("agency_id") @db.Uuid
  title           String
  departmentId    String?     @map("department_id") @db.Uuid
  positions       Int         @default(1)
  hiringManagerId String?     @map("hiring_manager_id")
  /// Monthly pay the agency means to offer, in rupees.
  budgetFrom      Int?        @map("budget_from")
  budgetTo        Int?        @map("budget_to")
  /// open · on_hold · closed
  status          String      @default("open")
  definition      String      @default("")
  deliverables    String[]
  tasks           String[]
  /// { skills, knowledge, selfImage, traits, motives }: lines for each.
  competence      Json        @default("{}")
  /// The behavioural interview's questions: { situation, task, action, result }.
  star            Json        @default("{}")
  sources         String[]
  createdBy       String?     @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  candidates      Candidate[]

  @@index([agencyId, status])
  @@map("openings")
}

/// Someone applying for an opening (P5-10), from their application to joining or not.
model Candidate {
  id             String               @id @default(uuid(7)) @db.Uuid
  agencyId       String               @map("agency_id") @db.Uuid
  openingId      String               @map("opening_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  city           String?
  source         String?
  experience     String?
  currentPay     Int?                 @map("current_pay")
  expectedPay    Int?                 @map("expected_pay")
  notes          String?
  /// applied · screening · interview · scorecard · approval · offer · joined · rejected
  stage          String               @default("applied")
  rejectedReason String?              @map("rejected_reason")
  approvedBy     String?              @map("approved_by")
  approvedAt     DateTime?            @map("approved_at")
  /// { designation, monthlyPay, joiningDate, role, notes, status, madeAt }
  offer          Json?
  /// The invitation to the workspace when they join, and who they became.
  invitationId   String?              @map("invitation_id")
  userId         String?              @map("user_id")
  createdBy      String?              @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")
  opening        Opening              @relation(fields: [openingId], references: [id], onDelete: Restrict)
  interviews     Interview[]
  scorecards     InterviewScorecard[]

  @@index([agencyId, openingId, stage])
  @@index([invitationId])
  @@map("candidates")
}

/// An interview with a candidate (P5-10), on the interviewer's calendar.
model Interview {
  id            String    @id @default(uuid(7)) @db.Uuid
  agencyId      String    @map("agency_id") @db.Uuid
  candidateId   String    @map("candidate_id") @db.Uuid
  at            DateTime
  interviewerId String    @map("interviewer_id")
  /// in_person · video · phone
  mode          String    @default("in_person")
  where         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([agencyId, at])
  @@index([candidateId])
  @@map("interviews")
}

/// One interviewer's scorecard for a candidate (P5-10): five ratings, the STAR answers and the task, by the agency's rule.
model InterviewScorecard {
  id             String    @id @default(uuid(7)) @db.Uuid
  agencyId       String    @map("agency_id") @db.Uuid
  candidateId    String    @map("candidate_id") @db.Uuid
  interviewerId  String    @map("interviewer_id")
  ratings        Json
  star           Json
  taskScore      Int       @map("task_score")
  remarks        String    @default("")
  total          Int
  percent        Int
  /// hire · hold · not_taken
  recommendation String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, interviewerId])
  @@map("interview_scorecards")
}

// ───────────────────────────── Performance and learning ─────────────────────────────

/// The agency's performance rule (P5-11): the bar for the A–C rating, and who sees the leaderboard.
model PerformanceSettings {
  agencyId  String   @id @map("agency_id") @db.Uuid
  rule      Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("performance_settings")
}

/// A role's KRAs (P5-11): each with how it is measured, the target and weight, and a quality gate.
model KraTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  name      String
  /// [{ key, name, measure, unit, target, weight, lowerIsBetter, metric }]
  kras      Json
  /// { key, threshold, cap }
  gate      Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, name])
  @@map("kra_templates")
}

/// A person's month (P5-11): the KRAs as they stood, what was achieved, the score, shared with them by their reviewer.
model MonthScorecard {
  id           String    @id @default(uuid(7)) @db.Uuid
  agencyId     String    @map("agency_id") @db.Uuid
  userId       String    @map("user_id")
  /// YYYY-MM
  month        String
  templateName String    @map("template_name")
  /// The template's KRAs with { actual, auto } for the month.
  kras         Json
  gate         Json?
  raw          Float
  score        Float
  gated        Boolean   @default(false)
  /// draft · shared
  status       String    @default("draft")
  reviewerId   String?   @map("reviewer_id")
  note         String    @default("")
  /// What the person said about it.
  reply        String?
  sharedAt     DateTime? @map("shared_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, userId, month])
  @@index([agencyId, month])
  @@map("month_scorecards")
}

/// A person's A–C rating for a month (P5-11), by competence and commitment.
model PlayerRating {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  userId    String   @map("user_id")
  month     String
  /// { skill, knowledge, selfImage, motive, trait }: 1 to 5.
  ratings   Json
  /// A · B_competence · B_commitment · C
  player    String
  note      String   @default("")
  ratedBy   String?  @map("rated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, userId, month])
  @@map("player_ratings")
}

/// A learning path (P5-11): modules with their hours and where to find them.
model LearningPath {
  id          String               @id @default(uuid(7)) @db.Uuid
  agencyId    String               @map("agency_id") @db.Uuid
  title       String
  forRole     String               @default("") @map("for_role")
  description String               @default("")
  ownerId     String?              @map("owner_id")
  /// [{ key, title, hours, link }]
  modules     Json
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at")
  assignments LearningAssignment[]

  @@map("learning_paths")
}

/// A path given to a person (P5-11), and the modules they have done.
model LearningAssignment {
  id          String       @id @default(uuid(7)) @db.Uuid
  agencyId    String       @map("agency_id") @db.Uuid
  pathId      String       @map("path_id") @db.Uuid
  userId      String       @map("user_id")
  done        String[]
  assignedBy  String?      @map("assigned_by")
  assignedAt  DateTime     @default(now()) @map("assigned_at")
  completedAt DateTime?    @map("completed_at")
  path        LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, userId])
  @@index([agencyId, userId])
  @@map("learning_assignments")
}

/// A skill on the agency's skill matrix (P5-11).
model Skill {
  id       String       @id @default(uuid(7)) @db.Uuid
  agencyId String       @map("agency_id") @db.Uuid
  name     String
  group    String       @default("")
  position Int          @default(0)
  levels   SkillLevel[]

  @@unique([agencyId, name])
  @@map("skills")
}

/// How far a person has come with a skill (P5-11): 0 not yet … 4 can teach.
model SkillLevel {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  userId    String   @map("user_id")
  level     Int
  ratedBy   String?  @map("rated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, userId])
  @@map("skill_levels")
}

// ───────────────────────────── Daily data sheet ─────────────────────────────

/// The agency's daily sheet rules (P5-12): the shift, the cut-off, the slack before the day needs a reason.
model SheetSettings {
  agencyId  String   @id @map("agency_id") @db.Uuid
  rule      Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sheet_settings")
}

/// A role's daily sheet (P5-12): its counters, and who signs it in which order.
model SheetTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  name      String
  /// [{ key, label, hours, bad }]
  counters  Json     @default("[]")
  taskHint  String   @default("") @map("task_hint")
  /// manager · hr, in signing order.
  signers   String[]
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, name])
  @@map("sheet_templates")
}

/// One person's day on their sheet (P5-12): tasks with times, counters, submitted and signed.
model DailySheet {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  userId      String    @map("user_id")
  date        DateTime  @db.Date
  templateId  String    @map("template_id") @db.Uuid
  rows        Json      @default("[]")
  counters    Json      @default("{}")
  otherWorks  String    @default("") @map("other_works")
  dayReason   String    @default("") @map("day_reason")
  /// draft · submitted · signed
  status      String    @default("draft")
  submittedAt DateTime? @map("submitted_at")
  late        Boolean   @default(false)
  /// [{ signer, by, at }]
  signatures  Json      @default("[]")
  returnNote  String?   @map("return_note")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([agencyId, userId, date])
  @@index([agencyId, date])
  @@map("daily_sheets")
}

// ───────────────────────────── Goals ─────────────────────────────

/// The agency's goal rule (P5-13): when a goal is on track or at risk, when its year starts, and the revenue cascade as last saved.
model GoalSettings {
  agencyId  String   @id @map("agency_id") @db.Uuid
  rule      Json
  /// The revenue cascade's inputs as last saved.
  cascade   Json?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("goal_settings")
}

/// A goal (P5-13): the company's, a department's serving it, or a person's serving that.
model Goal {
  id           String        @id @default(uuid(7)) @db.Uuid
  agencyId     String        @map("agency_id") @db.Uuid
  parentId     String?       @map("parent_id") @db.Uuid
  /// company · department · person
  level        String
  title        String
  departmentId String?       @map("department_id") @db.Uuid
  /// financial · functional · learning · operational
  type         String
  ownerIds     String[]      @map("owner_ids")
  measure      String        @default("")
  /// inr · pct · count · hours · days
  unit         String
  baseline     Float         @default(0)
  target       Float
  /// Entered by hand when it does not follow a figure the app knows.
  actual       Float         @default(0)
  metric       String?
  startDate    DateTime      @map("start_date") @db.Date
  dueDate      DateTime      @map("due_date") @db.Date
  /// strategic · tactical · operational
  cadence      String
  /// { specific, measurable, achievable, relevant, timeBound }
  smart        Json          @default("{}")
  createdBy    String?       @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  checkIns     GoalCheckIn[]

  @@index([agencyId, parentId])
  @@map("goals")
}

/// A check-in on a goal (P5-13): an update, a breakthrough or a breakdown, with a new figure for a goal entered by hand.
model GoalCheckIn {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  by        String
  /// update · breakthrough · breakdown
  kind      String
  note      String
  value     Float?
  createdAt DateTime @default(now()) @map("created_at")
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([agencyId, goalId])
  @@map("goal_check_ins")
}

// ───────────────────────────── Round Table ─────────────────────────────

/// A Round Table (P5-15): the peer review in timed rounds, one person each, moderated and then released.
model RtSession {
  id               String     @id @default(uuid(7)) @db.Uuid
  agencyId         String     @map("agency_id") @db.Uuid
  name             String
  meetingId        String?    @map("meeting_id") @db.Uuid
  facilitatorId    String?    @map("facilitator_id")
  participantIds   String[]   @map("participant_ids")
  questions        String[]
  secondsPerPerson Int        @map("seconds_per_person")
  /// draft · live · moderation · released
  status           String     @default("draft")
  currentIndex     Int        @default(0) @map("current_index")
  roundEndsAt      DateTime?  @map("round_ends_at")
  releasedAt       DateTime?  @map("released_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  answers          RtAnswer[]

  @@index([agencyId, createdAt])
  @@map("rt_sessions")
}

/// What one person wrote about another (or themselves) in a Round Table (P5-15).
model RtAnswer {
  id           String    @id @default(uuid(7)) @db.Uuid
  agencyId     String    @map("agency_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  subjectId    String    @map("subject_id")
  authorId     String    @map("author_id")
  answers      String[]
  /// The buzzer went before they wrote anything.
  missed       Boolean   @default(false)
  hidden       Boolean   @default(false)
  hiddenReason String?   @map("hidden_reason")
  /// The commitment the subject made from it, on their own self row.
  commitmentId String?   @map("commitment_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  session      RtSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, subjectId, authorId])
  @@map("rt_answers")
}

// ───────────────────────────── SOPs and checklists ─────────────────────────────

/// An SOP (P5-17): how the agency does one thing, who does it, checks it and approves it, its PSS line and KRA.
model Sop {
  id            String       @id @default(uuid(7)) @db.Uuid
  agencyId      String       @map("agency_id") @db.Uuid
  title         String
  departmentId  String?      @map("department_id") @db.Uuid
  ownerId       String?      @map("owner_id")
  pssRef        String       @default("") @map("pss_ref")
  kraTemplateId String?      @map("kra_template_id") @db.Uuid
  kraKey        String?      @map("kra_key")
  doerIds       String[]     @map("doer_ids")
  checkerId     String?      @map("checker_id")
  approverId    String?      @map("approver_id")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  versions      SopVersion[]
  runs          SopRun[]

  @@index([agencyId, active])
  @@map("sops")
}

/// A version of an SOP (P5-17): drafted, approved before use, replaced by the next.
model SopVersion {
  id         String    @id @default(uuid(7)) @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  sopId      String    @map("sop_id") @db.Uuid
  number     Int
  /// draft · in_review · approved · superseded
  status     String    @default("draft")
  purpose    String    @default("")
  scope      String    @default("")
  /// [{ text }]
  steps      Json      @default("[]")
  /// [{ key, text }]
  checklist  Json      @default("[]")
  changeNote String    @default("") @map("change_note")
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  sop        Sop       @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@unique([sopId, number])
  @@map("sop_versions")
}

/// A run of an SOP's checklist (P5-17), checked by its checker.
model SopRun {
  id        String    @id @default(uuid(7)) @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  sopId     String    @map("sop_id") @db.Uuid
  versionId String    @map("version_id") @db.Uuid
  by        String
  about     String    @default("")
  /// [{ key, text, result, note }]
  items     Json
  note      String    @default("")
  /// submitted · passed · failed
  status    String    @default("submitted")
  checkedBy String?   @map("checked_by")
  checkedAt DateTime? @map("checked_at")
  checkNote String?   @map("check_note")
  createdAt DateTime  @default(now()) @map("created_at")
  sop       Sop       @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@index([agencyId, by, createdAt])
  @@map("sop_runs")
}

// ───────────────────────────── Business diagnostic ─────────────────────────────

/// The BFA taken at a time (P5-18): each function, the challenges and notes — first from the agency questionnaire.
