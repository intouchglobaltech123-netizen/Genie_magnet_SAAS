{
  "name": "@gm/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations and the tenant-scoped database client",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -b",
    "typecheck": "prisma generate && tsc -b",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "migrate:diff": "node scripts/with-temp-postgres.mjs npx prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --script",
    "seed": "node --env-file-if-exists=../../.env dist/seed/run.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@gm/config": "*",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test/database.d.ts",
      "default": "./dist/test/database.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    }
  }
}
